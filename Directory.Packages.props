<Project>

  <!-- Central Package Management: every package version is declared here once.
       Individual projects reference packages WITHOUT a Version attribute.
       The Revit SDK is the exception (see below) and uses VersionOverride per project,
       because its version floats per target framework. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared across projects -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- Excel: ClosedXML 0.102.1 is pinned together with DocumentFormat.OpenXml 2.20.0.
         OpenXml 3.x fails at runtime under Costura.Fody assembly embedding — do not bump independently. -->
    <PackageVersion Include="ClosedXML" Version="0.102.1" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="2.20.0" />

    <!-- Addin -->
    <PackageVersion Include="Fody" Version="6.8.2" />
    <PackageVersion Include="Costura.Fody" Version="5.7.0" />
    <PackageVersion Include="ricaun.Revit.UI" Version="0.7.1" />
    <PackageVersion Include="MaterialDesignColors" Version="5.2.1" />
    <PackageVersion Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageVersion Include="PolySharp" Version="1.14.1" />
    <PackageVersion Include="System.Text.Json" Version="8.0.5" />

    <!-- Bridge -->
    <PackageVersion Include="ModelContextProtocol" Version="1.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageVersion Include="xunit" Version="2.7.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <!-- Autodesk.Revit.SDK is intentionally NOT centralized: its version floats per target
       framework (2026.* for net8.0-windows, 2024.* for net48). The wildcard is deliberate —
       Autodesk ships frequent patch builds within a major version and the add-in is
       compatible across patches. Each project pins it with VersionOverride. -->

</Project>
