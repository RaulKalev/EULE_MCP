<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Reference only the pure-logic types; no Revit API dependency -->
  <ItemGroup>
    <Compile Include="..\RevitMCP.Addin\Electrical\CircuitElementClassifier.cs" Link="Electrical\CircuitElementClassifier.cs" />
    <Compile Include="..\RevitMCP.Addin\Electrical\LengthUnitHelper.cs" Link="Electrical\LengthUnitHelper.cs" />
    <Compile Include="..\RevitMCP.Addin\Electrical\CircuitLengthEstimator.cs" Link="Electrical\CircuitLengthEstimator.cs" />
  </ItemGroup>
</Project>
