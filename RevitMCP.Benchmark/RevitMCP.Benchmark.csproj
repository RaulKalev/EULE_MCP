<Project Sdk="Microsoft.NET.Sdk">

  <!-- Token/round-trip benchmark for the MCP surface (issue #67). Starts the real bridge over stdio
       with the official MCP client, so it measures exactly what Claude/Codex receive. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>RevitMCP.Benchmark</AssemblyName>
    <RootNamespace>RevitMCP.Benchmark</RootNamespace>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <None Update="scenarios.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
