<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>RevitMCP.Bridge</AssemblyName>
    <RootNamespace>RevitMCP.Bridge</RootNamespace>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitMCP.Core\RevitMCP.Core.csproj" />
  </ItemGroup>

  <!-- Pure timeout table shared with the add-in (#90); kept out of Core so hot-reloaded add-ins see it. -->
  <ItemGroup>
    <Compile Include="..\RevitMCP.Addin\Services\LongRunningTools.cs" Link="Shared\LongRunningTools.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
