<Project>

  <!-- Settings shared by every project in the solution.
       Project-specific settings (TargetFrameworks, OutputType, etc.) stay in each .csproj. -->
  <PropertyGroup>
    <!-- Common language / compiler settings -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Language versions are pinned per project/target framework. Do not use
         "latest": it makes compatibility depend on the developer's SDK. -->

    <!-- Versioning — single source of truth for all assemblies -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>EULE MCP</Product>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Generate NuGet lock files so restores use a reviewable dependency graph. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- .NET analyzers on every target (they are off by default for net48/netstandard2.0).
         Default mode only; the few correctness rules raised to warnings are listed in .editorconfig.
         Warnings never fail the build. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
