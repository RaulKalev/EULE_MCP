<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryBackground">White</Color>
    <Color x:Key="SecondaryBackground">#FFE0E0E0</Color>
    <Color x:Key="Border">#FFCCCCCC</Color>
    <Color x:Key="Foreground">Black</Color>
    <Color x:Key="TextHighlight">#FF0078D7</Color>
    <Color x:Key="IconColor">Black</Color>
    <Color x:Key="IconForeground">#FF1F1F1F</Color>
    <Color x:Key="IconHover">#FF808080</Color>
    <Color x:Key="IconPressed">#BEBEBE</Color>
    <Color x:Key="SelectionHover">#FFDDDDDD</Color>
    <Color x:Key="SelectionPressed">#FFB8D0EE</Color>
    <Color x:Key="ScrollBarThumb">#FFAAAAAA</Color>
    <Color x:Key="StatusRunning">#FF158D6A</Color>
    <Color x:Key="StatusStopped">#FFB42C2C</Color>

    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackground}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackground}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource Foreground}" />
    <SolidColorBrush x:Key="TextHighlightBrush" Color="{StaticResource TextHighlight}" />
    <SolidColorBrush x:Key="IconColorBrush" Color="{StaticResource IconColor}" />
    <SolidColorBrush x:Key="IconForegroundBrush" Color="{StaticResource IconForeground}" />
    <SolidColorBrush x:Key="IconHoverBrush" Color="{StaticResource IconHover}" />
    <SolidColorBrush x:Key="IconPressedBrush" Color="{StaticResource IconPressed}" />
    <SolidColorBrush x:Key="SelectionHoverBrush" Color="{StaticResource SelectionHover}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumb}" />
    <SolidColorBrush x:Key="StatusRunningBrush" Color="{StaticResource StatusRunning}" />
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="{StaticResource StatusStopped}" />

</ResourceDictionary>
