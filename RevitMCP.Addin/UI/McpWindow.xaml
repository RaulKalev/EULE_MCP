<Window
    x:Class="RevitMCP.Addin.UI.McpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:RevitMCP.Addin.UI.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ui="clr-namespace:RevitMCP.Addin.UI"
    Title="Revit MCP Connector"
    Width="360"
    Height="620"
    MinWidth="300"
    MinHeight="440"
    Background="{DynamicResource Window.Background}"
    PreviewKeyDown="Window_PreviewKeyDown"
    ShowInTaskbar="False"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True">
    <!--
        Compact, modeless tool window on the RK Tools design system (Sentinel tokens, palettes, styles, motion).
        One column: the page as a segmented control, the connector state first, what waits for approval next, and the
        emergency stop pinned to the bottom so it never moves. Technical details (pipe, view, routing, Direct Edit,
        plan limits, the activity log) only show with "Technical details" on (Ctrl+Shift+D).
        WindowChrome keeps native Windows behaviour (Snap, Alt+Space, resize borders, DWM shadow, Windows 11 corners).
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="40"
            CornerRadius="0"
            GlassFrameThickness="0,0,0,1"
            NonClientFrameEdges="None"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Palette + materials are replaced at runtime by ThemeManager; styles use DynamicResource  -->
                <ResourceDictionary Source="pack://application:,,,/RevitMCP.Addin;component/UI/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/RevitMCP.Addin;component/UI/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="Visible" />
            <converters:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <converters:IndexToBoolConverter x:Key="IsIndex" />
            <converters:SeverityToBrushConverter x:Key="SeverityBrush" />

            <!--  Page host: a TabControl without headers (the segmented control selects the page)  -->
            <!--  Foreground: the system theme styles of TabControl and TabItem set it to black, and the pages inherit it  -->
            <Style x:Key="PageHost" TargetType="{x:Type TabControl}">
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                <Setter Property="Visibility" Value="Collapsed" />
            </Style>

            <!--  Scrolling page body; content fades under the page switcher instead of being cut  -->
            <Style x:Key="PageScroll" TargetType="{x:Type ScrollViewer}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="OpacityMask">
                    <Setter.Value>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,14">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="1" Color="Black" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="InfoLabel"
                BasedOn="{StaticResource Type.Label}"
                TargetType="{x:Type TextBlock}">
                <Setter Property="DockPanel.Dock" Value="Left" />
            </Style>

            <!--  Empty state: glyph, one line, one hint  -->
            <Style x:Key="EmptyGlyph" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
    <Grid x:Name="RootGrid" Visibility="{Binding IsCompact, Converter={StaticResource Hidden}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ============ Caption (draggable; title left, window buttons right) ============  -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button
                    AutomationProperties.Name="Switch between dark and light appearance"
                    Click="ThemeButton_Click"
                    Style="{StaticResource CaptionButton}"
                    ToolTip="Switch between dark and light appearance">
                    <materialDesign:PackIcon
                        x:Name="ThemeIcon"
                        Width="16"
                        Height="16"
                        Kind="WeatherNight" />
                </Button>
                <Button
                    AutomationProperties.Name="Minimize"
                    Click="MinimizeButton_Click"
                    Style="{StaticResource CaptionButton}"
                    ToolTip="Collapse to a status strip (Ctrl+M)">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Kind="WindowMinimize" />
                </Button>
                <Button
                    AutomationProperties.Name="Close"
                    Click="CloseButton_Click"
                    Style="{StaticResource CaptionCloseButton}"
                    ToolTip="Close (the connector keeps running)">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Kind="WindowClose" />
                </Button>
            </StackPanel>
            <TextBlock
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="MCP Connector"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!--  ============ Page switcher ============  -->
        <Border
            Grid.Row="1"
            Margin="16,4,16,0"
            Style="{StaticResource Segmented}">
            <UniformGrid
                AutomationProperties.Name="Page"
                Rows="1"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                KeyboardNavigation.TabNavigation="Once">
                <RadioButton
                    Content="Status"
                    GroupName="Page"
                    Padding="4,0"
                    IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IsIndex}, ConverterParameter=0}"
                    Style="{StaticResource Segment}"
                    ToolTip="Connector and model (Ctrl+1)" />
                <RadioButton
                    AutomationProperties.Name="Pending approvals"
                    GroupName="Page"
                    Padding="4,0"
                    IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IsIndex}, ConverterParameter=1}"
                    Style="{StaticResource Segment}"
                    ToolTip="Changes waiting for your approval, and plans (Ctrl+2)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pending" />
                        <Border Style="{StaticResource CountPill}" Visibility="{Binding HasNoPendingApprovals, Converter={StaticResource Hidden}}">
                            <TextBlock HorizontalAlignment="Center" Text="{Binding PendingCount}" />
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    AutomationProperties.Name="Jobs"
                    GroupName="Page"
                    Padding="4,0"
                    IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IsIndex}, ConverterParameter=2}"
                    Style="{StaticResource Segment}"
                    ToolTip="Work the agent handed over to run by itself (Ctrl+3)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Jobs" />
                        <Border Style="{StaticResource CountPill}" Visibility="{Binding HasRunningJobs, Converter={StaticResource Visible}}">
                            <TextBlock HorizontalAlignment="Center" Text="{Binding RunningJobCount}" />
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    Content="Activity"
                    GroupName="Page"
                    Padding="4,0"
                    IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IsIndex}, ConverterParameter=3}"
                    Style="{StaticResource Segment}"
                    ToolTip="Every tool call this session (Ctrl+4)"
                    Visibility="{Binding IsDebugMode, Converter={StaticResource Visible}}" />
            </UniformGrid>
        </Border>

        <!--  ============ Pages ============  -->
        <TabControl
            Grid.Row="2"
            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
            Style="{StaticResource PageHost}">

            <!--  ─────────── Status ───────────  -->
            <TabItem>
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel Margin="16,16,16,16">

                        <!--  Connector state + the one action it needs  -->
                        <Border Padding="14,12" Style="{StaticResource Card}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button
                                        Command="{Binding StartCommand}"
                                        Content="Start"
                                        Style="{StaticResource Button.Primary}"
                                        ToolTip="Let AI agents connect to this Revit"
                                        Visibility="{Binding IsRunning, Converter={StaticResource Hidden}}" />
                                    <Button
                                        Command="{Binding StopCommand}"
                                        Content="Stop"
                                        Style="{StaticResource Button.Secondary}"
                                        ToolTip="Disconnect AI agents from this Revit"
                                        Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />
                                </Grid>
                                <materialDesign:PackIcon
                                    x:Name="StateGlyph"
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="{x:Type materialDesign:PackIcon}">
                                            <Setter Property="Kind" Value="PowerPlugOffOutline" />
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Neutral}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Kind" Value="CheckCircle" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Ok}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                                    <TextBlock FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource Type.Body}" TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="Connector stopped" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Text" Value="Connector running" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource Type.Secondary}" TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="Start it so an AI agent can work with this model." />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Text" Value="AI agents can read this model. Changes wait for your approval." />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsRunning}" Value="True" />
                                                            <Condition Binding="{Binding IsDirectEditEnabled}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="AI agents can read and change this model." />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!--  Direct Edit: one switch for everyone; the card turns red while it is on  -->
                        <Border Margin="0,12,0,0" Padding="14,12">
                            <Border.Style>
                                <Style BasedOn="{StaticResource Card}" TargetType="{x:Type Border}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDirectEditEnabled}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Status.Error.Subtle}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Status.Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.HelpText="{Binding Text, ElementName=DirectEditHint}"
                                    AutomationProperties.Name="Direct Edit"
                                    Command="{Binding ToggleDirectEditCommand}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Switch}"
                                    Tag="{Binding IsDirectEditEnabled}"
                                    ToolTip="Turn Direct Edit on or off" />
                                <StackPanel VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                                    <TextBlock Style="{StaticResource Type.Heading}" Text="Direct Edit" />
                                    <TextBlock x:Name="DirectEditHint" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource Type.Secondary}" TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="Off: every change waits for your approval." />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectEditEnabled}" Value="True">
                                                        <Setter Property="Text" Value="On: agents change the model without asking." />
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!--  This Revit  -->
                        <TextBlock Style="{StaticResource Type.Group}" Text="This Revit" />
                        <Border Padding="14,8" Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource InfoRow}">
                                    <TextBlock Style="{StaticResource InfoLabel}" Text="Model" />
                                    <TextBlock
                                        Style="{StaticResource InfoValue}"
                                        Text="{Binding ModelTitle}"
                                        ToolTip="{Binding ModelTitle}" />
                                </DockPanel>

                                <!--  Technical details  -->
                                <StackPanel Visibility="{Binding IsDebugMode, Converter={StaticResource Visible}}">
                                    <DockPanel Style="{StaticResource InfoRow}">
                                        <TextBlock Style="{StaticResource InfoLabel}" Text="View" />
                                        <TextBlock
                                            Style="{StaticResource InfoValue}"
                                            Text="{Binding ActiveView}"
                                            ToolTip="{Binding ActiveView}" />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource InfoRow}">
                                        <TextBlock Style="{StaticResource InfoLabel}" Text="Selected" />
                                        <TextBlock Style="{StaticResource InfoValue}" Text="{Binding SelectedElementCount, StringFormat={}{0} elements}" />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource InfoRow}">
                                        <TextBlock Style="{StaticResource InfoLabel}" Text="Workshared" />
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource InfoValue}" TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Text" Value="No" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWorkshared}" Value="True">
                                                            <Setter Property="Text" Value="Yes" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource InfoRow}">
                                        <TextBlock Style="{StaticResource InfoLabel}" Text="Pipe" />
                                        <TextBox
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Pipe name"
                                            FontFamily="{StaticResource Font.Mono}"
                                            Style="{StaticResource Input.ReadOnlyValue}"
                                            Text="{Binding PipeName, Mode=OneWay}"
                                            TextAlignment="Right"
                                            TextWrapping="NoWrap" />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource InfoRow}" ToolTip="When several Revit windows are open (e.g. 2024 and 2026), the MCP bridge sends requests to the active one first; otherwise the highest Revit version wins.">
                                        <TextBlock Style="{StaticResource InfoLabel}" Text="Agent target" />
                                        <Button
                                            Height="24"
                                            Margin="8,0,-8,0"
                                            Command="{Binding MakeActiveCommand}"
                                            Content="Use this Revit"
                                            DockPanel.Dock="Right"
                                            FontSize="{StaticResource FontSize.Secondary}"
                                            Style="{StaticResource Button.Plain}"
                                            Visibility="{Binding IsActiveInstance, Converter={StaticResource Hidden}}" />
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource InfoValue}" TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Text" Value="Auto" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActiveInstance}" Value="True">
                                                            <Setter Property="Text" Value="This Revit" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Project Village (read-only visualizer; technical details only, absent when unavailable)  -->
                        <StackPanel Visibility="{Binding IsDebugMode, Converter={StaticResource Visible}}">
                        <StackPanel Visibility="{Binding HasVillage, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource Type.Group}" Text="Project Village" />
                            <Border Padding="14,10" Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button
                                                Height="26"
                                                Command="{Binding Village.OpenCommand}"
                                                Content="Open"
                                                FontSize="{StaticResource FontSize.Secondary}"
                                                Style="{StaticResource Button.Plain}"
                                                ToolTip="Opens the Project Village page in your browser"
                                                Visibility="{Binding Village.IsRunning, Converter={StaticResource Visible}}" />
                                            <Button
                                                Height="26"
                                                Margin="4,0,0,0"
                                                Command="{Binding Village.ToggleCommand}"
                                                FontSize="{StaticResource FontSize.Secondary}"
                                                Style="{StaticResource Button.Secondary}"
                                                ToolTip="Starts or stops the localhost-only viewer page and remembers the choice (village.enabled)">
                                                <Button.Content>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Text" Value="Turn on" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Village.IsRunning}" Value="True">
                                                                        <Setter Property="Text" Value="Turn off" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button.Content>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Type.Secondary}"
                                            Text="Watch the agent's work as a village in your browser." />
                                    </DockPanel>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource Type.Caption}"
                                        Text="{Binding Village.StatusText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </StackPanel>

                        <!--  Detail level  -->
                        <CheckBox
                            x:Name="DebugCheck"
                            Margin="0,20,0,0"
                            AutomationProperties.Name="Show technical details"
                            IsChecked="{Binding IsDebugMode}"
                            Style="{StaticResource Input.Check}"
                            ToolTip="Ctrl+Shift+D">
                            <StackPanel>
                                <TextBlock FontSize="{StaticResource FontSize.Secondary}" Text="Technical details" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Pipe, routing, plan limits, Project Village and the activity log." />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ─────────── Pending ───────────  -->
            <TabItem>
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel Margin="16,16,16,16">

                        <!--  Waiting for approval  -->
                        <DockPanel Margin="0,0,0,8">
                            <Button
                                Height="24"
                                Margin="0,0,-8,0"
                                AutomationProperties.Name="Reject all pending requests"
                                Command="{Binding RejectAllCommand}"
                                Content="Reject all"
                                DockPanel.Dock="Right"
                                FontSize="{StaticResource FontSize.Secondary}"
                                Foreground="{DynamicResource Status.Error}"
                                Style="{StaticResource Button.Plain}"
                                Visibility="{Binding HasNoPendingApprovals, Converter={StaticResource Hidden}}" />
                            <TextBlock
                                Margin="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Type.Group}"
                                Text="Waiting for approval" />
                        </DockPanel>

                        <Border
                            Padding="16,20"
                            Style="{StaticResource InsetCard}"
                            Visibility="{Binding HasNoPendingApprovals, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="ShieldCheckOutline" Style="{StaticResource EmptyGlyph}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Nothing to approve" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource Type.Secondary}"
                                    Text="When an agent wants to change the model, the request waits here."
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ItemsControl Focusable="False" ItemsSource="{Binding PendingApprovals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="14,12"
                                        Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontFamily="{StaticResource Font.Mono}"
                                                Style="{StaticResource Type.Caption}"
                                                Text="{Binding Tool}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                Visibility="{Binding DataContext.IsDebugMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
                                            <!--  A plan's summary runs over several lines: capped, full text in the tooltip  -->
                                            <TextBlock
                                                MaxHeight="180"
                                                Style="{StaticResource Type.Body}"
                                                Text="{Binding Summary}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Summary}" />
                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Type.Caption}">
                                                <Run Text="{Binding Client, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Time, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                Style="{StaticResource Type.Caption}"
                                                Text="{Binding Model, StringFormat='Model: {0}'}"
                                                Visibility="{Binding DataContext.IsDebugMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
                                            <UniformGrid Margin="0,12,0,0" Columns="2">
                                                <Button
                                                    Margin="0,0,4,0"
                                                    Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding ApprovalId}"
                                                    Style="{StaticResource Button.Primary}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Check" Style="{StaticResource ButtonIconLabel}" />
                                                        <TextBlock Text="Approve" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    Margin="4,0,0,0"
                                                    Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding ApprovalId}"
                                                    Content="Reject"
                                                    Style="{StaticResource Button.Secondary}" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Plans (#99): one approval per plan; revoke ends it, show changes selects what it touched  -->
                        <StackPanel Visibility="{Binding HasPlans, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource Type.Group}" Text="Plans" />
                            <ItemsControl Focusable="False" ItemsSource="{Binding Plans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="14,10"
                                            Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border Margin="0,0,8,0" DockPanel.Dock="Left">
                                                        <Border.Style>
                                                            <Style BasedOn="{StaticResource Badge}" TargetType="{x:Type Border}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Status.Ok.Subtle}" />
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Status.Ok}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StateLabel}" />
                                                    </Border>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource Type.Heading}"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding PlanId}" />
                                                </DockPanel>
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    Style="{StaticResource Type.Secondary}"
                                                    Text="{Binding StateReason}"
                                                    Visibility="{Binding HasStateReason, Converter={StaticResource Visible}}" />
                                                <StackPanel Visibility="{Binding DataContext.IsDebugMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        Style="{StaticResource Type.Caption}"
                                                        Text="{Binding Progress}" />
                                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Type.Caption}">
                                                        <Run Text="{Binding Client, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Document, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel
                                                    Margin="-8,6,0,-4"
                                                    HorizontalAlignment="Left"
                                                    Orientation="Horizontal">
                                                    <Button
                                                        Height="26"
                                                        Command="{Binding DataContext.ShowPlanChangesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding PlanId}"
                                                        Content="Show changes"
                                                        FontSize="{StaticResource FontSize.Secondary}"
                                                        Style="{StaticResource Button.Plain}"
                                                        ToolTip="Select in Revit what the plan changed" />
                                                    <Button
                                                        Height="26"
                                                        Command="{Binding DataContext.RevokePlanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding PlanId}"
                                                        Content="Revoke"
                                                        FontSize="{StaticResource FontSize.Secondary}"
                                                        Foreground="{DynamicResource Status.Error}"
                                                        Style="{StaticResource Button.Plain}"
                                                        ToolTip="End the plan: further changes need their own approval"
                                                        Visibility="{Binding CanRevoke, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!--  Recent decisions: what happened after Approve / Reject  -->
                        <StackPanel Visibility="{Binding HasRecentApprovalOutcomes, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource Type.Group}" Text="Recent decisions" />
                            <Border Padding="12,4" Style="{StaticResource InsetCard}">
                                <ItemsControl Focusable="False" ItemsSource="{Binding RecentApprovalOutcomes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,8">
                                                <materialDesign:PackIcon DockPanel.Dock="Left">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style BasedOn="{StaticResource StatusGlyph}" TargetType="{x:Type materialDesign:PackIcon}">
                                                            <Setter Property="Width" Value="14" />
                                                            <Setter Property="Height" Value="14" />
                                                            <Setter Property="Kind" Value="MinusCircleOutline" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Status.Neutral}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StateLabel}" Value="RUNNING">
                                                                    <Setter Property="Kind" Value="ProgressClock" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Info}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                                                                    <Setter Property="Kind" Value="CheckCircleOutline" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Ok}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Kind" Value="AlertCircleOutline" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <StackPanel>
                                                    <TextBlock
                                                        MaxHeight="34"
                                                        Style="{StaticResource Type.Secondary}"
                                                        Foreground="{DynamicResource Text.Primary}"
                                                        Text="{Binding Summary}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding Summary}" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        Style="{StaticResource Type.Secondary}"
                                                        Text="{Binding Message}"
                                                        Visibility="{Binding HasMessage, Converter={StaticResource Visible}}" />
                                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Type.Caption}">
                                                        <Run Text="{Binding StateWord, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Time, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontFamily="{StaticResource Font.Mono}"
                                                        Style="{StaticResource Type.Caption}"
                                                        Text="{Binding Tool}"
                                                        Visibility="{Binding DataContext.IsDebugMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ─────────── Jobs (#100) ───────────  -->
            <TabItem>
                <Grid>
                    <ScrollViewer Style="{StaticResource PageScroll}">
                        <ItemsControl
                            Margin="16,16,16,8"
                            Focusable="False"
                            ItemsSource="{Binding Jobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="14,10"
                                        Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border Margin="0,0,8,0" DockPanel.Dock="Left">
                                                    <Border.Style>
                                                        <Style BasedOn="{StaticResource Badge}" TargetType="{x:Type Border}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent.Text}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBad}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Status.Error.Subtle}" />
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Status.Error}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StateLabel}" />
                                                </Border>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource Type.Heading}"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding JobId}" />
                                            </DockPanel>
                                            <ProgressBar
                                                Margin="0,10,0,0"
                                                AutomationProperties.Name="Job progress"
                                                Maximum="{Binding Total}"
                                                Style="{StaticResource Meter}"
                                                Value="{Binding Done}" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Style="{StaticResource Type.Caption}"
                                                Text="{Binding Progress}" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Style="{StaticResource Type.Secondary}"
                                                Text="{Binding StopReason}"
                                                Visibility="{Binding HasStopReason, Converter={StaticResource Visible}}" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                Style="{StaticResource Type.Caption}"
                                                Visibility="{Binding DataContext.IsDebugMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                                                <Run Text="{Binding Client, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Document, Mode=OneWay}" />
                                            </TextBlock>
                                            <WrapPanel Margin="-8,6,0,-4">
                                                <Button
                                                    Height="26"
                                                    Command="{Binding DataContext.ResumeJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding JobId}"
                                                    Content="Resume"
                                                    FontSize="{StaticResource FontSize.Secondary}"
                                                    Style="{StaticResource Button.Plain}"
                                                    Visibility="{Binding CanResume, Converter={StaticResource Visible}}" />
                                                <Button
                                                    Height="26"
                                                    Command="{Binding DataContext.PauseJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding JobId}"
                                                    Content="Pause"
                                                    FontSize="{StaticResource FontSize.Secondary}"
                                                    Style="{StaticResource Button.Plain}"
                                                    Visibility="{Binding CanPause, Converter={StaticResource Visible}}" />
                                                <Button
                                                    Height="26"
                                                    Command="{Binding DataContext.OpenJobReportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding JobId}"
                                                    Content="Open report"
                                                    FontSize="{StaticResource FontSize.Secondary}"
                                                    Style="{StaticResource Button.Plain}"
                                                    Visibility="{Binding HasReport, Converter={StaticResource Visible}}" />
                                                <Button
                                                    Height="26"
                                                    Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding JobId}"
                                                    Content="Cancel"
                                                    FontSize="{StaticResource FontSize.Secondary}"
                                                    Foreground="{DynamicResource Status.Error}"
                                                    Style="{StaticResource Button.Plain}"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource Visible}}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel
                        Margin="32,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasNoJobs, Converter={StaticResource Visible}}">
                        <materialDesign:PackIcon Kind="PlaylistCheck" Style="{StaticResource EmptyGlyph}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="No jobs" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Type.Secondary}"
                            Text="Work an agent hands over to run by itself shows up here."
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!--  ─────────── Activity (technical details) ───────────  -->
            <TabItem>
                <DockPanel Margin="16,12,16,8">
                    <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button
                                AutomationProperties.Name="Usage report"
                                Command="{Binding UsageReportCommand}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Last month's usage report from the shared usage folder (usage.sharedFolder)">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="ChartBoxOutline" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Open log folder"
                                Command="{Binding OpenLogFolderCommand}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Open log folder">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="FolderOpenOutline" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Clear the list"
                                Command="{Binding ClearActivityLogCommand}"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="Clear the list (the log files stay)">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="NotificationClearAll" />
                            </Button>
                        </StackPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Type.Secondary}"
                            Text="Tool calls this session" />
                    </DockPanel>

                    <Border
                        Margin="0,0,0,8"
                        ui:Motion.Reveal="True"
                        DockPanel.Dock="Top"
                        Style="{StaticResource Notice.Warning}"
                        Visibility="{Binding HasUsageReportMessage, Converter={StaticResource Visible}}">
                        <DockPanel>
                            <Button
                                Height="24"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Dismiss"
                                Command="{Binding DismissUsageReportMessageCommand}"
                                Content="OK"
                                DockPanel.Dock="Right"
                                FontSize="{StaticResource FontSize.Secondary}"
                                Style="{StaticResource Button.Plain}" />
                            <materialDesign:PackIcon
                                Width="14"
                                Height="14"
                                Margin="0,2,8,0"
                                VerticalAlignment="Top"
                                Foreground="{DynamicResource Status.Warning}"
                                Kind="AlertOutline" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Text="{Binding UsageReportMessage}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <Grid>
                        <Border Padding="0,4" Style="{StaticResource Surface}">
                            <ItemsControl
                                Focusable="False"
                                ItemsSource="{Binding ActivityLog}"
                                ScrollViewer.CanContentScroll="True"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="{x:Type ItemsControl}">
                                        <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel
                                            Height="30"
                                            Margin="10,0,10,0"
                                            Background="Transparent"
                                            ToolTip="{Binding Message}">
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                        <Setter Property="Kind" Value="InformationOutline" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Neutral}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                <Setter Property="Kind" Value="CheckCircleOutline" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Status.Ok}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Kind" Value="AlertCircleOutline" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Status.Error}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource Type.Caption}"
                                                Text="{Binding Time}" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource Type.Caption}"
                                                Text="{Binding DurationMs, StringFormat={}{0} ms}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource FontSize.Secondary}"
                                                Text="{Binding Tool}"
                                                TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock
                            Margin="24,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource Type.Secondary}"
                            Text="No tool calls yet."
                            TextAlignment="Center"
                            Visibility="{Binding HasNoActivity, Converter={StaticResource Visible}}" />
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!--  ============ Emergency stop (pinned; reachable from every page) ============  -->
        <Border
            Grid.Row="3"
            Padding="16,10,16,12"
            Background="{DynamicResource Toolbar.Material}"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="0,1,0,0">
            <Button
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Emergency stop: reject all requests and disconnect"
                Command="{Binding PanicStopCommand}"
                Style="{StaticResource Button.Destructive}"
                ToolTip="Rejects every request waiting for approval and disconnects all agents">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="StopCircleOutline" Style="{StaticResource ButtonIconLabel}" />
                    <TextBlock Text="Emergency stop" />
                </StackPanel>
            </Button>
        </Border>

        <!--  ============ Sheet: turn on Direct Edit ============  -->
        <Grid
            x:Name="DirectEditSheet"
            Grid.Row="0"
            Grid.RowSpan="4"
            Background="{DynamicResource Scrim}"
            KeyboardNavigation.TabNavigation="Cycle"
            Visibility="Collapsed">
            <Border
                x:Name="DirectEditCard"
                Margin="16"
                Padding="20,18"
                VerticalAlignment="Center"
                Style="{StaticResource Floating}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Status.Error}"
                            Kind="AlertCircleOutline" />
                        <TextBlock Style="{StaticResource Type.Section}" Text="Turn on Direct Edit?" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Type.Body}">
                        AI agents will change the model <Run FontWeight="SemiBold">without asking</Run>. Every write runs immediately instead of waiting in Pending.
                    </TextBlock>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Type.Secondary}"
                        Text="Turn it on for work you trust, and check the result afterwards. You can turn it off again at any time." />
                    <CheckBox
                        x:Name="DontAskAgainCheck"
                        Margin="0,16,0,0"
                        Content="Don't ask again"
                        FontSize="{StaticResource FontSize.Secondary}"
                        Style="{StaticResource Input.Check}" />
                    <UniformGrid Margin="0,18,0,0" Columns="2">
                        <Button
                            x:Name="DirectEditCancelButton"
                            Margin="0,0,4,0"
                            Click="DirectEditCancel_Click"
                            Content="Cancel"
                            IsCancel="True"
                            Style="{StaticResource Button.Secondary}" />
                        <Button
                            Margin="4,0,0,0"
                            Click="DirectEditConfirm_Click"
                            Content="Turn on"
                            Style="{StaticResource Button.Destructive}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

    <!--
        ============ Compact status strip (Minimize, Ctrl+M) ============
        The window shrinks in place to one 40 px row: status dot, the most important thing right now, a count, the
        emergency stop and expand. It takes its own mouse input (IsHitTestVisibleInChrome) so a click can expand it;
        a press that moves past the drag threshold drags the window instead. Never focusable: a peek must not take
        focus from Revit.
    -->
    <Grid
        x:Name="CompactStrip"
        AutomationProperties.Name="MCP connector status"
        Background="{DynamicResource Toolbar.Material}"
        Focusable="False"
        MouseEnter="CompactStrip_MouseEnter"
        MouseLeave="CompactStrip_MouseLeave"
        MouseLeftButtonDown="CompactStrip_MouseLeftButtonDown"
        MouseLeftButtonUp="CompactStrip_MouseLeftButtonUp"
        MouseMove="CompactStrip_MouseMove"
        ToolTip="{Binding HeadlineText}"
        Visibility="{Binding IsCompact, Converter={StaticResource Visible}}"
        WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="16,0,6,0">
            <Button
                AutomationProperties.Name="Expand the connector window"
                Click="ExpandButton_Click"
                DockPanel.Dock="Right"
                Focusable="False"
                Style="{StaticResource Button.Icon}"
                ToolTip="Expand (Ctrl+M or Escape)">
                <materialDesign:PackIcon
                    Width="16"
                    Height="16"
                    Kind="ChevronUp" />
            </Button>
            <Button
                AutomationProperties.Name="Emergency stop: reject all requests and disconnect"
                Command="{Binding PanicStopCommand}"
                DockPanel.Dock="Right"
                Focusable="False"
                Foreground="{DynamicResource Status.Error}"
                Style="{StaticResource Button.Icon}"
                ToolTip="Emergency stop: rejects every request waiting for approval and disconnects all agents">
                <materialDesign:PackIcon
                    Width="16"
                    Height="16"
                    Kind="StopCircleOutline" />
            </Button>
            <Border
                Margin="6,0,6,0"
                DockPanel.Dock="Right"
                Style="{StaticResource CountPill}"
                Visibility="{Binding HasHeadlineCount, Converter={StaticResource Visible}}">
                <TextBlock HorizontalAlignment="Center" Text="{Binding HeadlineCount}" />
            </Border>
            <Ellipse
                x:Name="StatusDot"
                Width="8"
                Height="8"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left">
                <Ellipse.Fill>
                    <MultiBinding Converter="{StaticResource SeverityBrush}">
                        <Binding Path="HeadlineSeverity" />
                        <Binding RelativeSource="{RelativeSource Self}" />
                    </MultiBinding>
                </Ellipse.Fill>
            </Ellipse>
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                FontWeight="SemiBold"
                Text="{Binding HeadlineText}"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!--  Peek: a new request while collapsed; DataContext is that request (set by the window)  -->
        <StackPanel
            x:Name="PeekPanel"
            Grid.Row="1"
            Margin="16,0,16,8"
            Visibility="Collapsed">
            <TextBlock
                Margin="0,0,0,6"
                Style="{StaticResource Type.Caption}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap">
                <Run Text="{Binding Tool, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Summary, Mode=OneWay}" />
            </TextBlock>
            <StackPanel Orientation="Horizontal">
                <Button
                    Height="{StaticResource Size.IconButton}"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Approve this request"
                    Click="PeekDecision_Click"
                    Command="{Binding DataContext.ApproveCommand, ElementName=CompactStrip}"
                    CommandParameter="{Binding ApprovalId}"
                    Content="Approve"
                    Focusable="False"
                    Style="{StaticResource Button.Primary}" />
                <Button
                    Height="{StaticResource Size.IconButton}"
                    AutomationProperties.Name="Reject this request"
                    Click="PeekDecision_Click"
                    Command="{Binding DataContext.RejectCommand, ElementName=CompactStrip}"
                    CommandParameter="{Binding ApprovalId}"
                    Content="Reject"
                    Focusable="False"
                    Style="{StaticResource Button.Secondary}" />
            </StackPanel>
        </StackPanel>

        <!--
            Activity: while the agent calls tools a 3 px outline breathes around the strip's edge and a brighter segment
            runs around it (the window's code sets the dash to the perimeter). With animations off: a static outline.
            Radius 7 follows the Windows 11 window corner.
        -->
        <Grid
            x:Name="ActivityLine"
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Opacity="0">
            <Rectangle
                x:Name="ActivityOutline"
                Opacity="0.35"
                RadiusX="7"
                RadiusY="7"
                Stroke="{DynamicResource Accent}"
                StrokeThickness="3" />
            <Rectangle
                x:Name="ActivitySweep"
                RadiusX="7"
                RadiusY="7"
                SizeChanged="ActivitySweep_SizeChanged"
                Stroke="{DynamicResource Accent}"
                StrokeDashCap="Round"
                StrokeThickness="3"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
    </Grid>
</Window>
