<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RevitMCP.Addin</AssemblyName>
    <RootNamespace>RevitMCP.Addin</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CA1416</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Revit 2026 (.NET 8) — full tool surface incl. write tools and WPF UI -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <UseWPF>true</UseWPF>
    <DefineConstants>$(DefineConstants);REVIT2026</DefineConstants>
  </PropertyGroup>

  <!-- Revit 2024 (.NET Framework 4.8) — read-only subset, no WPF window -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <DefineConstants>$(DefineConstants);REVIT2024</DefineConstants>
    <!-- Suppress net48-specific warnings that are noise for this Revit context -->
    <NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>
  </PropertyGroup>

  <!-- net48: make polyfill extension methods (Contains(char), Deconstruct, TryAdd, etc.) globally visible -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Using Include="RevitMCP.Addin.Compat" />
  </ItemGroup>

  <!-- Common packages -->
  <ItemGroup>
    <PackageReference Include="Fody" Version="6.8.2" PrivateAssets="All" ExcludeAssets="runtime" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="All" />
    <!-- ClosedXML 0.102.1 uses DocumentFormat.OpenXml >= 2.16.0 (no 3.x requirement).
         OpenXml 3.x uses reflection-based part validation that fails at runtime in Revit's
         Costura.Fody assembly-embedding context. Pinning both packages to stable 2.x resolves this. -->
    <PackageReference Include="ClosedXML" Version="0.102.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.20.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ricaun.Revit.UI" Version="0.7.1" />
  </ItemGroup>

  <!-- Revit SDK — TFM-conditional -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Autodesk.Revit.SDK" Version="2026.*" IncludeAssets="build; compile" PrivateAssets="All" />
    <PackageReference Include="MaterialDesignColors" Version="5.2.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Autodesk.Revit.SDK" Version="2024.*" IncludeAssets="build; compile" PrivateAssets="All" />
    <!-- Polyfills: enables `init`, `required`, records, etc. on .NET Framework 4.8 -->
    <PackageReference Include="PolySharp" Version="1.14.1" PrivateAssets="all" />
    <!-- System.Text.Json (JsonNode/JsonObject/JsonSerializerOptions) is in-box on .NET 8 but a separate package on net48 -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitMCP.Core\RevitMCP.Core.csproj" />
  </ItemGroup>

  <!-- Assets (WPF Resource items) only needed for the .NET 8 build that includes the UI -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Resource Include="Assets\RevitMCP.tiff" />
    <Resource Include="Assets\Dark - RevitMCP.tiff" />
    <Resource Include="Assets\Light - RevitMCP.tiff" />
    <Resource Include="Assets\Dark - AI1.tiff" />
    <Resource Include="Assets\Light - AI1.tiff" />
  </ItemGroup>

  <!-- net48 build: exclude WPF UI, approval system, ribbon command, and write-only tool families.
       The connector + pipe server still run; AI clients get the read-only tool subset. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- WPF-specific assembly attributes (ThemeInfo) -->
    <Compile Remove="AssemblyInfo.cs" />
    <!-- UI (WPF window, view models, themes, converters, dialog) -->
    <Compile Remove="UI\**\*.cs" />
    <Page Remove="UI\**\*.xaml" />
    <None Remove="UI\**\*.xaml" />
    <!-- Ribbon command (depends on UI window) -->
    <Compile Remove="Commands\**\*.cs" />
    <!-- IFC Space-to-Room writes rooms; preview tools also live here and pull in writer deps -->
    <Compile Remove="Tools\IfcSpaceToRoom\**\*.cs" />
    <!-- Write tools: parameter writes, circuit creation/edits, sheet/view writes, deletes, family creation, skill runs -->
    <Compile Remove="Tools\SetParameterTool.cs" />
    <Compile Remove="Tools\SetCircuitParameterTool.cs" />
    <Compile Remove="Tools\SetCircuitParametersBulkTool.cs" />
    <Compile Remove="Tools\SetCircuitPathModeTool.cs" />
    <Compile Remove="Tools\SetSheetParametersBulkTool.cs" />
    <Compile Remove="Tools\SetViewParametersBulkTool.cs" />
    <Compile Remove="Tools\CreateElectricalCircuitTool.cs" />
    <Compile Remove="Tools\AddElementsToCircuitTool.cs" />
    <Compile Remove="Tools\ReassignCircuitPanelTool.cs" />
    <Compile Remove="Tools\ChangeCircuitCableOrWireTypeTool.cs" />
    <Compile Remove="Tools\ApplyCircuitNumberingTool.cs" />
    <Compile Remove="Tools\ApplyCircuitLoadNamesTool.cs" />
    <Compile Remove="Tools\ApplyViewTemplateTool.cs" />
    <Compile Remove="Tools\PlaceViewsOnSheetsTool.cs" />
    <Compile Remove="Tools\DuplicateSheetsTool.cs" />
    <Compile Remove="Tools\DuplicateViewsTool.cs" />
    <Compile Remove="Tools\CreateSheetsFromTableTool.cs" />
    <Compile Remove="Tools\RenameViewsTool.cs" />
    <Compile Remove="Tools\RenameSheetsTool.cs" />
    <Compile Remove="Tools\DeleteViewsTool.cs" />
    <Compile Remove="Tools\DeleteSheetsTool.cs" />
    <Compile Remove="Tools\RunFireAlarmCircuitPresetTool.cs" />
    <Compile Remove="Tools\RunViewSheetWorkflowPresetTool.cs" />
    <Compile Remove="Tools\RunClashPresetTool.cs" />
    <Compile Remove="Tools\CreateClashReviewViewTool.cs" />
    <Compile Remove="Tools\FocusClashTool.cs" />
    <Compile Remove="Tools\CreatePanelSchematicSymbolFromDwgTool.cs" />
    <Compile Remove="Tools\RunSkillTool.cs" />
    <Compile Remove="Tools\RunSkillTaskTool.cs" />
    <Compile Remove="Tools\CreateProjectSkillOverrideTool.cs" />
    <Compile Remove="Tools\UpdateProjectSkillOverrideTool.cs" />
    <Compile Remove="Tools\ResetProjectSkillOverrideTool.cs" />
    <Compile Remove="Tools\ConfigureSheetNamingSkillTool.cs" />
    <Compile Remove="Tools\ProposeSkillMasterUpdateTool.cs" />
    <!-- Electrical circuit write helpers (only used by excluded write tools) -->
    <Compile Remove="Electrical\CircuitMutationService.cs" />
  </ItemGroup>

</Project>
